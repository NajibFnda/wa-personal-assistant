# Server
PORT=3000

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (opsional tapi sangat direkomendasikan — ultra-cepat < 1 detik, Whisper STT, & auto-fallback bersama Gemini)
GROQ_API_KEY=your_groq_api_key_here

# Opsional: Model Gemini utama (default: gemini-3.8-flash dengan auto-fallback)
GEMINI_MODEL=gemini-3.8-flash

# Nomor WhatsApp Utama Pengguna (format internasional tanpa + atau spasi, contoh: 6281234567890)
NOMOR_UTAMA=6281234567890

# Web Push VAPID Keys (generate dengan: npm run generate-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Opsional: PIN sederhana untuk mengunci akses Web Dashboard (kosongkan jika tidak ingin kunci PIN)
WEB_PIN=

# Opsional: Token kustom untuk feed kalender .ics (kosongkan untuk generate otomatis tersimpan di SQLite)
CALENDAR_TOKEN=

# Opsional: Topik rahasia ntfy.sh untuk dering keras HP (kosongkan untuk generate otomatis tersimpan di SQLite)
NTFY_TOPIC=
